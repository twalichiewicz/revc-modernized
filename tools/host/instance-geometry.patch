@@ -88,14 +89,42 @@ CEntity::CEntity(void)
 	m_area = AREA_MAIN_MAP;
 	m_randomSeed = CGeneral::GetRandomNumber();
 	m_pFirstReference = nil;
+	m_instanceColModel = nil;
+	m_instanceColRevision = 0;
+	m_inCollisionWorld = false;
 }
 
 CEntity::~CEntity(void)
 {
+	assert(!m_instanceColModel || !m_inCollisionWorld);
+	delete m_instanceColModel;
+	m_instanceColModel = nil;
 	DeleteRwObject();
 	ResolveReferences();
 }
 
+// Main-thread quiescent publication only. No callback may retain the old COL.
+// Prepared arrays and bounds belong to the caller until this returns true.
+bool
+CEntity::ReplaceInstanceCollision(CColModel *model)
+{
+	if(m_modelIndex < 0 || m_modelIndex >= MODELINFOSIZE || !CModelInfo::GetModelInfo(m_modelIndex) ||
+	   !model || !model->ownsCollisionVolumes || model == GetColModel() ||
+	   m_instanceColRevision == ~(uint64)0) return false;
+	const CVector lo = model->boundingBox.min, hi = model->boundingBox.max;
+	if(!std::isfinite(lo.x) || !std::isfinite(lo.y) || !std::isfinite(lo.z) ||
+	   !std::isfinite(hi.x) || !std::isfinite(hi.y) || !std::isfinite(hi.z) ||
+	   lo.x > hi.x || lo.y > hi.y || lo.z > hi.z) return false;
+	const bool resident = m_inCollisionWorld;
+	if(resident) CWorld::Remove(this);
+	CColModel *old = m_instanceColModel;
+	m_instanceColModel = model;
+	++m_instanceColRevision;
+	if(resident) CWorld::Add(this);
+	delete old; // CColModel retires its native triangle planes/cache entry.
+	return true;
+}
