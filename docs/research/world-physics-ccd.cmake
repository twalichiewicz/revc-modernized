# Add the research target at the end of upstream configuration, without editing
# or installing IPC Toolkit. Used via CMAKE_PROJECT_IPCToolkit_INCLUDE.
function(world_physics_add_ccd_probe)
  foreach(probe ccd contact persistent incremental rigid)
  set(probe_file "${probe}")
  if(probe STREQUAL "contact")
    set(probe_file "contact-event")
  elseif(probe STREQUAL "incremental")
    set(probe_file "incremental-material")
  endif()
  add_executable(world_physics_${probe} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/world-physics-${probe_file}-probe.cpp")
  target_compile_features(world_physics_${probe} PRIVATE cxx_std_17)
  target_compile_options(world_physics_${probe} PRIVATE -Wall -Wextra)
  target_compile_definitions(world_physics_${probe} PRIVATE BT_USE_DOUBLE_PRECISION)
  target_include_directories(world_physics_${probe} SYSTEM PRIVATE "${WORLD_PHYSICS_BULLET_SOURCE}/src")
  target_link_libraries(world_physics_${probe} PRIVATE ipc::toolkit)
  foreach(library BulletSoftBody BulletDynamics BulletCollision LinearMath)
    target_link_libraries(world_physics_${probe} PRIVATE "${WORLD_PHYSICS_BULLET_BUILD}/src/${library}/lib${library}.a")
  endforeach()
  endforeach()
endfunction()
cmake_language(DEFER CALL world_physics_add_ccd_probe)
